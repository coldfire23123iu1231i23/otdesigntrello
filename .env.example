# Bắt buộc — lấy key & token ở https://trello.com/power-ups/admin (tạo Power-Up → API key → Token)
TRELLO_KEY=your_trello_api_key
TRELLO_TOKEN=your_trello_token
# id ngắn của board (trong URL trello.com/b/XXXXXXXX/...). Board TrueWave Des: F9GPoy23
TRELLO_BOARD=F9GPoy23

# Tuỳ chọn
# TZ=Asia/Bangkok
# CRON_DAILY=30 22 * * *        # tự quét 22:30 mỗi ngày (ghi log)
# CONFIG_PATH=/data/config.json  # dùng với Railway Volume để lưu phân loại bền vững
# BASIC_USER=admin               # bật đăng nhập cơ bản (tuỳ chọn)
# BASIC_PASS=matkhau
# PORT=3000
